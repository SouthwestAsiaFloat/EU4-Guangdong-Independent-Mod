		# Zhou/Tianxia HUD entry. This is independent from the native hardcoded
		# Celestial Empire button and must never replace its dragon emblem.
		windowType = {
			name = "zhx_tianxia_topbar_window"
			orientation = "LOWER_RIGHT"
			scripted = yes

			guiButtonType = {
				name = "zhx_tianxia_open_button"
				# Preserve the old text button's right edge and vertical centre while
				# changing its 87x32 footprint to the approved 52x52 round control.
				position = { x = -330 y = -205 }
				quadTextureSprite = "GFX_zhx_tianxia_topbar_button"
				clicksound = click
				scripted = yes
			}
		}

		# The Zhou/Tianxia panel is a child of the always-present topbar, so the
		# lower-right button can open it directly from the map without another view.
		windowType = {
			name = "zhx_tianxia_window"
			backGround = "zhx_gui_drag_surface"
			# Nested CENTER positions are interpreted as the child's upper-left
			# corner. Keep the 980-wide canvas horizontally centred, but anchor its
			# visible 850-pixel content just below the top HUD so the merit store is
			# reachable without first dragging the window.
			position = { x = -490 y = -450 }
			size = { x = 980 y = 990 }
			# This is deliberately a floating child window. Clicking it raises it
			# above the native country-view tabs, then the player can drag it freely.
			moveable = 1
			click_to_front = yes
			dontRender = ""
			horizontalBorder = ""
			verticalBorder = ""
			fullScreen = no
			Orientation = "CENTER"
			scripted = yes

			guiButtonType = {
				name = "zhx_gui_drag_surface"
				quadTextureSprite = "GFX_zhx_tianxia_drag_surface"
				position = { x = 0 y = 0 }
				tooltip = ""
				tooltipText = ""
				delayedTooltipText = ""
			}

			# The visible artwork is not the WindowType background. Clausewitz snaps
			# background controls to (0, 0), which would offset every visual slot.
			iconType = {
				name = "zhx_gui_background"
				spriteType = "GFX_zhx_tianxia_bg"
				position = { x = 40 y = 20 }
				alwaystransparent = yes
			}

			# Zhou/Tianxia presentation. This scripted child is gated as one unit by
			# common/custom_gui/zhx_tianxia_gui.txt.
